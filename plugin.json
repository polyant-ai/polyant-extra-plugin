{
  "name": "extra",
  "version": "1.2.0",
  "engine": ">=1.3.0",
  "namespace": "extra",
  "toolsDir": "tools",
  "oauthProviders": [],
  "system": {
    "apk": [
      "chromium",
      "nss",
      "freetype",
      "harfbuzz",
      "ca-certificates",
      "ttf-freefont",
      "font-noto-emoji"
    ],
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "true",
      "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium-browser"
    }
  },
  "displayName": {
    "en-US": "Extra tools",
    "it-IT": "Strumenti extra"
  },
  "description": {
    "en-US": "Optional tools: Markdown rendered to PDF, and file uploads to the agent's S3 bucket.",
    "it-IT": "Tool opzionali: Markdown trasformato in PDF e caricamento di file nel bucket S3 dell'agente."
  }
}
